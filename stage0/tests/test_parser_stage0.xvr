include std;
include lexer;
include parser;
include test_helpers;

proc test_var_decl() {
    std::print("=== Test: Var Declaration ===\n");
    initLexer("var x = 42");
    initParser();
    var count = parse([]);
    assertTrue(count > 0, "parsed at least 1 node for var decl");
}

proc test_if_stmt() {
    std::print("=== Test: If Statement ===\n");
    initLexer("if x { y }");
    initParser();
    var count = parse([]);
    assertTrue(count > 0, "parsed if statement");
}

proc test_while_stmt() {
    std::print("=== Test: While Statement ===\n");
    initLexer("while x { y }");
    initParser();
    var count = parse([]);
    assertTrue(count > 0, "parsed while statement");
}

proc test_return() {
    std::print("=== Test: Return ===\n");
    initLexer("return 42");
    initParser();
    var count = parse([]);
    assertTrue(count > 0, "parsed return statement");
}

proc main() {
    std::print("Stage0 Parser Tests\n\n");
    test_var_decl();
    test_if_stmt();
    test_while_stmt();
    test_return();
    std::print("\n=== All Parser Tests Passed ===\n");
}

main();
