include std;
include lexer;
include parser;
include test_helpers;

proc main(): void {
    std::print("Test: a + b * 3\n");
    initLexer("a + b * 3");
    initParser();
    var result = parse();
    assertTrue(result > 0, "binary expression parsed successfully");

    std::print("Test: -x\n");
    initLexer("-x");
    initParser();
    result = parse();
    assertTrue(result > 0, "unary expression parsed successfully");

    std::print("Test: a[i]\n");
    initLexer("a[i]");
    initParser();
    result = parse();
    assertTrue(result > 0, "index expression parsed successfully");

    std::print("");
    std::print("All expression parser tests passed\n");
}
main();
