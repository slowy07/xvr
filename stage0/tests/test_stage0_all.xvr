include std;
include test_helpers;

proc main() {
    std::print("======================================\n");
    std::print("  Stage0 Bootstrap Compiler Tests\n");
    std::print("======================================\n");

    initLexer("var x = 42");
    while (nextToken().type != EOF) { }
    assertEq(tokenCount(), 5, "lexer produces 5 tokens for 'var x = 42'");

    initParser();
    var nodeCount = parse();
    assertTrue(nodeCount > 0, "parser produces nodes");

    initCodegen();
    var ir = getIR();
    assertEq(len(ir), 0, "codegen IR starts empty");

    std::print("\n======================================\n");
    std::print("  ALL TESTS PASSED\n");
    std::print("======================================\n");
}

main();
