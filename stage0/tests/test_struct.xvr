include std;
include codegen;
include test_helpers;

proc test_struct_token() {
    std::print("=== Test: Struct Token ===\n");
    var tokType = 20;
    assertEq(tokType, 20, "struct token type value");
}

proc test_struct_ast() {
    std::print("=== Test: Struct AST ===\n");
    var structKind = 9;
    assertEq(structKind, 9, "struct AST kind value");
}

proc test_struct_codegen() {
    std::print("=== Test: Struct Codegen ===\n");
    initCodegen();
    var structIR = generateStruct("Point", 2);
    assertTrue(len(structIR) > 10, "struct IR is non-trivial length");
}

proc main() {
    std::print("Stage0 Struct Tests\n\n");
    test_struct_token();
    test_struct_ast();
    test_struct_codegen();
    std::print("\n=== All Struct Tests Passed ===\n");
}

main();
