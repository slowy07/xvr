include std;
include lexer;
include parser;
include codegen;
include test_helpers;

proc test_codegen_basic() {
    std::print("=== Test: Basic Codegen ===\n");
    initLexer("var x = 42");
    initParser();
    initCodegen();
    generate();
    var ir = getIR();
    assertTrue(len(ir) > 0, "generated IR is non-empty");
}

proc test_generate_function() {
    std::print("=== Test: Generate Function ===\n");
    initCodegen();
    var fn = generateFunction("main", "  ret i32 0");
    assertTrue(len(fn) > 10, "function IR is non-trivial length");
}

proc test_generate_if() {
    std::print("=== Test: Generate If ===\n");
    initCodegen();
    var ir = generateIf("%cond", "  br label %end", "");
    assertTrue(len(ir) > 20, "if IR is non-trivial length");
}

proc test_generate_while() {
    std::print("=== Test: Generate While ===\n");
    initCodegen();
    var ir = generateWhile("%cond", "  br label %cond");
    assertTrue(len(ir) > 20, "while IR is non-trivial length");
}

proc main() {
    std::print("Stage0 Codegen Tests\n\n");
    test_codegen_basic();
    test_generate_function();
    test_generate_if();
    test_generate_while();
    std::print("\n=== All Codegen Tests Passed ===\n");
}

main();
