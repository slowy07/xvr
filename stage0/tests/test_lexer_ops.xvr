include std;
include test_helpers;

proc main(): void {
    initLexer("== != <= >= && || -> ..");
    var tok = nextToken();
    assertEq(tok.type, 37, "token type for ==");
    tok = nextToken();
    assertEq(tok.type, 38, "token type for !=");
    tok = nextToken();
    assertEq(tok.type, 40, "token type for <=");
    tok = nextToken();
    assertEq(tok.type, 42, "token type for >=");
    tok = nextToken();
    assertEq(tok.type, 43, "token type for &&");
    tok = nextToken();
    assertEq(tok.type, 44, "token type for ||");
    tok = nextToken();
    assertEq(tok.type, 57, "token type for ->");
    tok = nextToken();
    assertEq(tok.type, 58, "token type for ..");
}
main();
