include lexer;

var NODE_PROGRAM: i32 = 0;
var NODE_LITERAL: i32 = 1;
var NODE_IDENTIFIER: i32 = 2;
var NODE_BINARY_OP: i32 = 3;
var NODE_VARIABLE_DECL: i32 = 4;
var NODE_FUNCTION_DECL: i32 = 5;
var NODE_IF_STMT: i32 = 6;
var NODE_WHILE_STMT: i32 = 7;
var NODE_RETURN_STMT: i32 = 8;
var NODE_STRUCT_DEF: i32 = 9;
var NODE_STRUCT_FIELD: i32 = 10;
var NODE_STRUCT_INIT: i32 = 11;
var NODE_STRUCT_ACCESS: i32 = 12;
var NODE_UNARY_OP: i32 = 13;
var NODE_CALL: i32 = 14;
var NODE_INDEX: i32 = 15;
var NODE_FIELD: i32 = 16;
var NODE_CONDITIONAL: i32 = 17;
var NODE_GROUPING: i32 = 18;

var g_astKinds: [i32];
var g_astValues: [string];
var g_astLefts: [i32];
var g_astRights: [i32];
var g_astExtras: [i32];
var g_currentToken: i32;
var g_tokenCount: i32;
var g_nodeCount: i32;

proc initParser() {
    g_astKinds = [];
    g_astValues = [];
    g_astLefts = [];
    g_astRights = [];
    g_astExtras = [];
    g_currentToken = 0;
    g_nodeCount = 0;
}

proc advance() {
    if (g_currentToken < lexer::tokenCount()) {
        g_currentToken = g_currentToken + 1;
    }
}

proc currentTokenType(): i32 {
    if (g_currentToken < lexer::tokenCount()) {
        return lexer::getTokenType(g_currentToken);
    }
    return EOF;
}

proc currentLexeme(): string {
    if (g_currentToken < lexer::tokenCount()) {
        return lexer::getTokenLexeme(g_currentToken);
    }
    return "";
}

proc addNode(kind: i32, value: string, left: i32, right: i32, extra: i32): i32 {
    if (g_nodeCount >= 10000) {
        return -1;
    }
    g_astKinds.insert(kind);
    g_astValues.insert(value);
    g_astLefts.insert(left);
    g_astRights.insert(right);
    g_astExtras.insert(extra);
    var index: i32;
    index = g_nodeCount;
    g_nodeCount = g_nodeCount + 1;
    return index;
}

proc getPrecedence(tokType: i32): i32 {
    if (tokType == OP_OR) { return 2; }
    if (tokType == OP_AND) { return 3; }
    if (tokType == OP_EQ) { return 4; }
    if (tokType == OP_NEQ) { return 4; }
    if (tokType == OP_LT) { return 5; }
    if (tokType == OP_GT) { return 5; }
    if (tokType == OP_LTE) { return 5; }
    if (tokType == OP_GTE) { return 5; }
    if (tokType == OP_PLUS) { return 6; }
    if (tokType == OP_MINUS) { return 6; }
    if (tokType == OP_STAR) { return 7; }
    if (tokType == OP_SLASH) { return 7; }
    if (tokType == OP_PERCENT) { return 7; }
    return 0;
}

proc parsePrefix(): i32 {
    var tokType: i32;
    tokType = currentTokenType();

    if (tokType == INT_LITERAL) {
        var value: string;
        value = currentLexeme();
        advance();
        return addNode(NODE_LITERAL, value, -1, -1, -1);
    }
    if (tokType == STRING_LITERAL) {
        var value: string;
        value = currentLexeme();
        advance();
        return addNode(NODE_LITERAL, value, -1, -1, -1);
    }

    if (tokType == IDENT) {
        var value: string;
        value = currentLexeme();
        advance();
        if (currentTokenType() == LPAREN) {
            advance();
            var argCount: i32;
            argCount = 0;
            if (currentTokenType() != RPAREN) {
                var arg: i32;
                arg = parseExpression(0);
                argCount = 1;
                while (currentTokenType() == COMMA) {
                    advance();
                    arg = parseExpression(0);
                    argCount = argCount + 1;
                }
            }
            advance();
            return addNode(NODE_CALL, value, argCount, -1, -1);
        }
        return addNode(NODE_IDENTIFIER, value, -1, -1, -1);
    }

    if (tokType == LPAREN) {
        advance();
        var expr: i32;
        expr = parseExpression(0);
        advance();
        return addNode(NODE_GROUPING, "", expr, -1, -1);
    }

    if (tokType == OP_MINUS) {
        advance();
        var operand: i32;
        operand = parseExpression(8);
        return addNode(NODE_UNARY_OP, "-", operand, -1, -1);
    }
    if (tokType == OP_NOT) {
        advance();
        var operand: i32;
        operand = parseExpression(8);
        return addNode(NODE_UNARY_OP, "!", operand, -1, -1);
    }

    return -1;
}

proc parseInfix(left: i32, leftPrec: i32): i32 {
    var tokType: i32;
    tokType = currentTokenType();

    if (tokType == OP_PLUS) {
        var opLexeme: string;
        opLexeme = currentLexeme();
        advance();
        var right: i32;
        right = parseExpression(leftPrec);
        return addNode(NODE_BINARY_OP, opLexeme, left, right, tokType);
    }
    if (tokType == OP_MINUS) {
        var opLexeme: string;
        opLexeme = currentLexeme();
        advance();
        var right: i32;
        right = parseExpression(leftPrec);
        return addNode(NODE_BINARY_OP, opLexeme, left, right, tokType);
    }
    if (tokType == OP_STAR) {
        var opLexeme: string;
        opLexeme = currentLexeme();
        advance();
        var right: i32;
        right = parseExpression(leftPrec);
        return addNode(NODE_BINARY_OP, opLexeme, left, right, tokType);
    }
    if (tokType == OP_SLASH) {
        var opLexeme: string;
        opLexeme = currentLexeme();
        advance();
        var right: i32;
        right = parseExpression(leftPrec);
        return addNode(NODE_BINARY_OP, opLexeme, left, right, tokType);
    }
    if (tokType == OP_PERCENT) {
        var opLexeme: string;
        opLexeme = currentLexeme();
        advance();
        var right: i32;
        right = parseExpression(leftPrec);
        return addNode(NODE_BINARY_OP, opLexeme, left, right, tokType);
    }
    if (tokType == OP_EQ) {
        var opLexeme: string;
        opLexeme = currentLexeme();
        advance();
        var right: i32;
        right = parseExpression(leftPrec);
        return addNode(NODE_BINARY_OP, opLexeme, left, right, tokType);
    }
    if (tokType == OP_NEQ) {
        var opLexeme: string;
        opLexeme = currentLexeme();
        advance();
        var right: i32;
        right = parseExpression(leftPrec);
        return addNode(NODE_BINARY_OP, opLexeme, left, right, tokType);
    }
    if (tokType == OP_LT) {
        var opLexeme: string;
        opLexeme = currentLexeme();
        advance();
        var right: i32;
        right = parseExpression(leftPrec);
        return addNode(NODE_BINARY_OP, opLexeme, left, right, tokType);
    }
    if (tokType == OP_GT) {
        var opLexeme: string;
        opLexeme = currentLexeme();
        advance();
        var right: i32;
        right = parseExpression(leftPrec);
        return addNode(NODE_BINARY_OP, opLexeme, left, right, tokType);
    }
    if (tokType == OP_LTE) {
        var opLexeme: string;
        opLexeme = currentLexeme();
        advance();
        var right: i32;
        right = parseExpression(leftPrec);
        return addNode(NODE_BINARY_OP, opLexeme, left, right, tokType);
    }
    if (tokType == OP_GTE) {
        var opLexeme: string;
        opLexeme = currentLexeme();
        advance();
        var right: i32;
        right = parseExpression(leftPrec);
        return addNode(NODE_BINARY_OP, opLexeme, left, right, tokType);
    }
    if (tokType == OP_AND) {
        var opLexeme: string;
        opLexeme = currentLexeme();
        advance();
        var right: i32;
        right = parseExpression(leftPrec);
        return addNode(NODE_BINARY_OP, opLexeme, left, right, tokType);
    }
    if (tokType == OP_OR) {
        var opLexeme: string;
        opLexeme = currentLexeme();
        advance();
        var right: i32;
        right = parseExpression(leftPrec);
        return addNode(NODE_BINARY_OP, opLexeme, left, right, tokType);
    }

    if (tokType == LBRACKET) {
        advance();
        var index: i32;
        index = parseExpression(0);
        advance();
        return addNode(NODE_INDEX, "", left, index, -1);
    }

    if (tokType == DOT) {
        advance();
        var fieldName: string;
        fieldName = currentLexeme();
        advance();
        return addNode(NODE_FIELD, fieldName, left, -1, -1);
    }

    return -1;
}

proc parseExpression(prec: i32): i32 {
    var left: i32;
    left = parsePrefix();
    if (left == -1) { return -1; }

    while (true) {
        var tokType: i32;
        tokType = currentTokenType();
        var nextPrec: i32;
        nextPrec = 0;

        if (tokType == LBRACKET) {
            nextPrec = 9;
        } else {
            if (tokType == DOT) {
                nextPrec = 9;
            } else {
                nextPrec = getPrecedence(tokType);
            }
        }

        if (nextPrec == 0) { break; }
        if (prec >= nextPrec) { break; }

        left = parseInfix(left, nextPrec);
        if (left == -1) { return -1; }
    }

    return left;
}

proc parseStatement(): i32 {
    var tokType: i32;
    tokType = currentTokenType();

    if (tokType == KW_VAR) {
        advance();
        var name: string;
        name = currentLexeme();
        advance();
        var value: i32;
        value = parseExpression(0);
        return addNode(NODE_VARIABLE_DECL, name, value, -1, -1);
    }

    if (tokType == KW_IF) {
        advance();
        var cond: i32;
        cond = parseExpression(0);
        var thenBranch: i32;
        thenBranch = parseExpression(0);
        var elseBranch: i32;
        elseBranch = -1;
        if (currentTokenType() == KW_ELSE) {
            advance();
            elseBranch = parseExpression(0);
        }
        return addNode(NODE_IF_STMT, "", cond, thenBranch, elseBranch);
    }

    if (tokType == KW_WHILE) {
        advance();
        var cond: i32;
        cond = parseExpression(0);
        var body: i32;
        body = parseExpression(0);
        return addNode(NODE_WHILE_STMT, "", cond, body, -1);
    }

    if (tokType == KW_RETURN) {
        advance();
        var value: i32;
        value = parseExpression(0);
        return addNode(NODE_RETURN_STMT, "", value, -1, -1);
    }

    if (tokType == KW_PROC) {
        advance();
        var name: string;
        name = currentLexeme();
        advance();
        advance();
        advance();
        var body: i32;
        body = parseBlock();
        return addNode(NODE_FUNCTION_DECL, name, body, -1, -1);
    }

    if (tokType == KW_STRUCT) {
        advance();
        var name: string;
        name = currentLexeme();
        advance();
        advance();  // skip {

        var fieldCount = 0;
        while (g_currentToken < lexer::tokenCount() - 1) {
            var fieldName = currentLexeme();
            if (fieldName == "}") {
                break;
            }
            advance();
            advance();
            fieldCount = fieldCount + 1;
        }

        return addNode(NODE_STRUCT_DEF, name, fieldCount, -1, -1);
    }

    return parseExpression(0);
}

proc parseBlock(): i32 {
    advance();  // skip {
    var count: i32;
    count = 0;
    while (g_currentToken < lexer::tokenCount() - 1) {
        var stmt: i32;
        stmt = parseStatement();
        if (stmt >= 0) {
            count = count + 1;
        } else {
            advance();
        }
    }
    advance();  // skip }
    return count;
}

var g_result: i32;

proc finalizeParse() {
    g_result = g_nodeCount;
}

proc parse(tokens: [i32]): i32 {
    g_astKinds = [];
    g_astValues = [];
    g_astLefts = [];
    g_astRights = [];
    g_astExtras = [];
    g_currentToken = 0;
    g_nodeCount = 1;
    g_astKinds.insert(NODE_PROGRAM);
    g_astValues.insert("");
    g_astLefts.insert(-1);
    g_astRights.insert(-1);
    g_astExtras.insert(-1);
    g_tokenCount = lexer::tokenCount();
    while (g_currentToken < g_tokenCount - 1) {
        var stmt: i32;
        stmt = parseStatement();
        if (stmt == -1) {
            g_currentToken = g_currentToken + 1;
        }
    }
    finalizeParse();
    return g_result;
}
