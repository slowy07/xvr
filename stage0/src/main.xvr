include lexer;
include parser;
include codegen;

proc run(): void {
    std::print("Stage0 Bootstrap Compiler v0.1.0\n");

    var source = "var x = 42";
    initLexer(source);

    var tok: Token;
    tok = nextToken();
    while (tok.type != EOF) {
        tok = nextToken();
    }

    initParser();
    var nodeCount = parse();

    initCodegen();
    var i: i32;
    i = 0;
    while (i < nodeCount) {
        generateNode(parser::getAstKind(i), parser::getAstLeft(i), parser::getAstRight(i),
                     parser::getAstExtra(i), parser::getAstValue(i));
        i = i + 1;
    }
    var ir: string;
    ir = getIR();
    std::print("=== Generated LLVM IR ===\n");
    std::print("; Module ID 'stage0'\n");
    std::print("source_filename = \"stage0.llvm\"\n");
    std::print("\n");
    std::print("define i32 @main() {\n");
    std::print("entry:\n");
    if (len(ir) > 0) {
        std::print(ir);
    } else {
        std::print("  ; (no IR generated — parser/var-decl handling WIP)\n");
    }
    std::print("  ret i32 0\n");
    std::print("}\n");
}

run();