include lexer;
include parser;
include codegen;

var g_ir: string;

proc run(): void {
    print("Stage0 Bootstrap Compiler v0.1.0\n");
    print("Testing lexer with string: 'var x = 42'\n");
    
    var source = "var x = 42";
    initLexer(source);
    
    print("Calling nextToken...\n");
    var tok = nextToken();
    print("Got token: lexeme='{}' type={}\n", tok.lexeme, tok.type);
    
    tok = nextToken();
    print("Got token: lexeme='{}' type={}\n", tok.lexeme, tok.type);
    
    tok = nextToken();
    print("Got token: lexeme='{}' type={}\n", tok.lexeme, tok.type);
    
    tok = nextToken();
    print("Got token: lexeme='{}' type={}\n", tok.lexeme, tok.type);
    
    tok = nextToken();
    print("Got token: lexeme='{}' type={}\n", tok.lexeme, tok.type);
    
    initParser();
    initCodegen();
    generate();
    g_ir = getIR();
    
    print("\n=== Generated LLVM IR ===\n");
    print(g_ir);
    print("\nStage0 ready - lexer works, parser/codegen need implementation\n");
}

run();