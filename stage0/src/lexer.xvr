include token;

var g_source: string;
var g_pos: i32;
var g_line: i32;
var g_tokenCount: i32;
var g_tokenTypeValues: [i32];
var g_tokenLexemes: [string];
var g_tokenLines: [i32];

proc initLexer(source: string) {
    g_source = source;
    g_pos = 0;
    g_line = 1;
    g_tokenCount = 0;
    g_tokenTypeValues = [];
    g_tokenLexemes = [];
    g_tokenLines = [];
}

proc nextToken(): Token {
    while (g_pos < len(g_source)) {
        var c: string;
        c = g_source.subString(g_pos, 1);

        var isSpace: bool;
        isSpace = false;
        if (c == " ") { isSpace = true; }
        if (c == "\t") { isSpace = true; }
        if (c == "\n") { isSpace = true; }

        if (isSpace) {
            if (c == "\n") {
                g_line = g_line + 1;
            }
            g_pos = g_pos + 1;
        } else {
            var isDigit: bool;
            isDigit = false;
            if (c >= "0") { if (c <= "9") { isDigit = true; } }

            if (isDigit) {
                var lexeme: string;
                lexeme = "";
                var isFloat = false;
                
                while (g_pos < len(g_source)) {
                    var currC: string;
                    currC = g_source.subString(g_pos, 1);
                    
                    if (currC == "." && !isFloat) {
                        isFloat = true;
                        lexeme = lexeme + currC;
                        g_pos = g_pos + 1;
                    } else if (currC >= "0" && currC <= "9") {
                        lexeme = lexeme + currC;
                        g_pos = g_pos + 1;
                    } else {
                        break;
                    }
                }
                
                var tok: Token;
                tok.type = if (isFloat) { FLOAT_LITERAL } else { INT_LITERAL };
                tok.lexeme = lexeme;
                tok.line = g_line;
                
                // Bounds check
                if (g_tokenCount < 10000) {
                    g_tokenTypeValues.insert(tok.type);
                    g_tokenLexemes.insert(lexeme);
                    g_tokenLines.insert(g_line);
                    g_tokenCount = g_tokenCount + 1;
                }
                return tok;
            } else {
                var isAlpha: bool;
                isAlpha = false;
                if (c >= "a") { if (c <= "z") { isAlpha = true; } }
                if (c >= "A") { if (c <= "Z") { isAlpha = true; } }
                if (c == "_") { isAlpha = true; }

                if (isAlpha) {
                    var lexeme: string;
                    lexeme = "";
                    while (isAlpha) {
                        lexeme = lexeme + c;
                        g_pos = g_pos + 1;
                        if (g_pos >= len(g_source)) { break; }
                        c = g_source.subString(g_pos, 1);
                        isAlpha = false;
                        if (c >= "a") { if (c <= "z") { isAlpha = true; } }
                        if (c >= "A") { if (c <= "Z") { isAlpha = true; } }
                        if (c == "_") { isAlpha = true; }
                        if (c >= "0") { if (c <= "9") { isAlpha = true; } }
                    }
                    
                    var tokType: i32;
                    tokType = IDENT;
                    if (lexeme == "var") { tokType = KW_VAR; }
                    if (lexeme == "if") { tokType = KW_IF; }
                    if (lexeme == "else") { tokType = KW_ELSE; }
                    if (lexeme == "while") { tokType = KW_WHILE; }
                    if (lexeme == "for") { tokType = KW_FOR; }
                    if (lexeme == "return") { tokType = KW_RETURN; }
                    if (lexeme == "proc") { tokType = KW_PROC; }
                    if (lexeme == "true") { tokType = KW_TRUE; }
                    if (lexeme == "false") { tokType = KW_FALSE; }
                    if (lexeme == "struct") { tokType = KW_STRUCT; }
                    if (lexeme == "const") { tokType = KW_CONST; }
                    if (lexeme == "fn") { tokType = KW_FN; }
                    if (lexeme == "include") { tokType = KW_INCLUDE; }
                    if (lexeme == "void") { tokType = KW_VOID; }
                    
                    var tok: Token;
                    tok.type = tokType;
                    tok.lexeme = lexeme;
                    tok.line = g_line;
                    
                    // Bounds check
                    if (g_tokenCount < 10000) {
                        g_tokenTypeValues.insert(tokType);
                        g_tokenLexemes.insert(lexeme);
                        g_tokenLines.insert(g_line);
                        g_tokenCount = g_tokenCount + 1;
                    }
                    return tok;
                } else if (c == "\"") {
                    var lexeme: string;
                    lexeme = "";
                    g_pos = g_pos + 1;
                    while (g_pos < len(g_source)) {
                        var currC: string;
                        currC = g_source.subString(g_pos, 1);
                        if (currC == "\"") {
                            g_pos = g_pos + 1;
                            break;
                        }
                        lexeme = lexeme + currC;
                        g_pos = g_pos + 1;
                    }
                    
                    var tok: Token;
                    tok.type = STRING_LITERAL;
                    tok.lexeme = lexeme;
                    tok.line = g_line;
                    
                    // Bounds check
                    if (g_tokenCount < 10000) {
                        g_tokenTypeValues.insert(STRING_LITERAL);
                        g_tokenLexemes.insert(lexeme);
                        g_tokenLines.insert(g_line);
                        g_tokenCount = g_tokenCount + 1;
                    }
                    return tok;
                } else {
                    var tokType: i32;
                    tokType = INVALID;
                    if (c == "(") { tokType = LPAREN; }
                    if (c == ")") { tokType = RPAREN; }
                    if (c == "{") { tokType = LBRACE; }
                    if (c == "}") { tokType = RBRACE; }
                    if (c == "[") { tokType = LBRACKET; }
                    if (c == "]") { tokType = RBRACKET; }
                    if (c == ",") { tokType = COMMA; }
                    if (c == ";") { tokType = SEMICOLON; }
                    if (c == ":") { tokType = COLON; }
                    if (c == ".") { tokType = DOT; }
                    if (c == "=") { tokType = EQ; }
                    if (c == "+") { tokType = OP_PLUS; }
                    if (c == "-") { tokType = OP_MINUS; }
                    if (c == "*") { tokType = OP_STAR; }
                    if (c == "/") { tokType = OP_SLASH; }
                    if (c == "%") { tokType = OP_PERCENT; }
                    
                    var tok: Token;
                    tok.type = tokType;
                    tok.lexeme = c;
                    tok.line = g_line;
                    
                    // Bounds check
                    if (g_tokenCount < 10000) {
                        g_tokenTypeValues.insert(tokType);
                        g_tokenLexemes.insert(c);
                        g_tokenLines.insert(g_line);
                        g_tokenCount = g_tokenCount + 1;
                    }
                    g_pos = g_pos + 1;
                    return tok;
                }
            }
        }
    }
    
    var eof: Token;
    eof.type = EOF;
    eof.lexeme = "";
    eof.line = g_line;
    
    // Bounds check
    if (g_tokenCount < 10000) {
        g_tokenTypeValues.insert(EOF);
        g_tokenLexemes.insert("");
        g_tokenLines.insert(g_line);
        g_tokenCount = g_tokenCount + 1;
    }
    return eof;
}

proc lex(source: string): [Token] {
    initLexer(source);
    nextToken();
    while (g_pos < len(g_source)) {
        nextToken();
    }
    var result: [Token];
    result = [];
    var i: i32;
    i = 0;
    while (i < g_tokenCount) {
        var t: Token;
        t.type = g_tokenTypeValues[i];
        t.lexeme = g_tokenLexemes[i];
        t.line = g_tokenLines[i];
        result.insert(t);
        i = i + 1;
    }
    return result;
}

proc tokenCount(): i32 {
    return g_tokenCount;
}

proc getTokenType(n: i32): i32 {
    if (n >= 0 && n < g_tokenCount) {
        return g_tokenTypeValues[n];
    }
    return EOF;
}

proc getTokenLexeme(n: i32): string {
    if (n >= 0 && n < g_tokenCount) {
        return g_tokenLexemes[n];
    }
    return "";
}
