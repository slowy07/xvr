include token;

var g_source: string;
var g_pos: i32;
var g_line: i32;
var g_tokenCount: i32;
var g_tokenTypeValues: [i32];
var g_tokenLexemes: [string];
var g_tokenLines: [i32];

proc initLexer(source: string) {
    g_source = source;
    g_pos = 0;
    g_line = 1;
    g_tokenCount = 0;
    g_tokenTypeValues = [];
    g_tokenLexemes = [];
    g_tokenLines = [];
}

proc addToken(type: i32, lexeme: string, line: i32) {
    if (g_tokenCount >= 10000) { return; }
    g_tokenTypeValues.insert(type);
    g_tokenLexemes.insert(lexeme);
    g_tokenLines.insert(line);
    g_tokenCount = g_tokenCount + 1;
}

proc peek(): string {
    if (g_pos + 1 < len(g_source)) {
        return g_source.subString(g_pos + 1, 1);
    }
    return "";
}

proc nextToken(): Token {
    while (g_pos < len(g_source)) {
        var c: string;
        c = g_source.subString(g_pos, 1);

        var isSpace: bool;
        isSpace = false;
        if (c == " ") { isSpace = true; }
        if (c == "\t") { isSpace = true; }
        if (c == "\n") { isSpace = true; }

        if (isSpace) {
            if (c == "\n") {
                g_line = g_line + 1;
            }
            g_pos = g_pos + 1;
        } else {
            var isDigit: bool;
            isDigit = false;
            if (c >= "0") { if (c <= "9") { isDigit = true; } }

            if (isDigit) {
                var lexeme: string;
                lexeme = "";
                var isFloat = false;
                
                while (g_pos < len(g_source)) {
                    var currC: string;
                    currC = g_source.subString(g_pos, 1);
                    
                    if (currC == "." && !isFloat) {
                        isFloat = true;
                        lexeme = lexeme + currC;
                        g_pos = g_pos + 1;
                    } else if (currC >= "0" && currC <= "9") {
                        lexeme = lexeme + currC;
                        g_pos = g_pos + 1;
                    } else {
                        break;
                    }
                }
                
                var tok: Token;
                tok.type = if (isFloat) { FLOAT_LITERAL } else { INT_LITERAL };
                tok.lexeme = lexeme;
                tok.line = g_line;
                
                addToken(tok.type, lexeme, g_line);
                return tok;
            } else {
                var isAlpha: bool;
                isAlpha = false;
                if (c >= "a") { if (c <= "z") { isAlpha = true; } }
                if (c >= "A") { if (c <= "Z") { isAlpha = true; } }
                if (c == "_") { isAlpha = true; }

                if (isAlpha) {
                    var lexeme: string;
                    lexeme = "";
                    while (isAlpha) {
                        lexeme = lexeme + c;
                        g_pos = g_pos + 1;
                        if (g_pos >= len(g_source)) { break; }
                        c = g_source.subString(g_pos, 1);
                        isAlpha = false;
                        if (c >= "a") { if (c <= "z") { isAlpha = true; } }
                        if (c >= "A") { if (c <= "Z") { isAlpha = true; } }
                        if (c == "_") { isAlpha = true; }
                        if (c >= "0") { if (c <= "9") { isAlpha = true; } }
                    }
                    
                    var tokType: i32;
                    tokType = IDENT;
                    if (lexeme == "var") { tokType = KW_VAR; }
                    if (lexeme == "if") { tokType = KW_IF; }
                    if (lexeme == "else") { tokType = KW_ELSE; }
                    if (lexeme == "while") { tokType = KW_WHILE; }
                    if (lexeme == "for") { tokType = KW_FOR; }
                    if (lexeme == "return") { tokType = KW_RETURN; }
                    if (lexeme == "proc") { tokType = KW_PROC; }
                    if (lexeme == "true") { tokType = KW_TRUE; }
                    if (lexeme == "false") { tokType = KW_FALSE; }
                    if (lexeme == "struct") { tokType = KW_STRUCT; }
                    if (lexeme == "const") { tokType = KW_CONST; }
                    if (lexeme == "fn") { tokType = KW_FN; }
                    if (lexeme == "include") { tokType = KW_INCLUDE; }
                    if (lexeme == "void") { tokType = KW_VOID; }
                    
                    var tok: Token;
                    tok.type = tokType;
                    tok.lexeme = lexeme;
                    tok.line = g_line;
                    
                    addToken(tokType, lexeme, g_line);
                    return tok;
                } else if (c == "\"") {
                    var lexeme: string;
                    lexeme = "";
                    var unterminated: bool;
                    unterminated = true;
                    g_pos = g_pos + 1;
                    while (g_pos < len(g_source)) {
                        var currC: string;
                        currC = g_source.subString(g_pos, 1);
                        if (currC == "\"") {
                            g_pos = g_pos + 1;
                            unterminated = false;
                            break;
                        }
                        lexeme = lexeme + currC;
                        g_pos = g_pos + 1;
                    }
                    
                    var tokType: i32;
                    tokType = if (unterminated) { INVALID } else { STRING_LITERAL };
                    
                    var tok: Token;
                    tok.type = tokType;
                    tok.lexeme = lexeme;
                    tok.line = g_line;
                    
                    addToken(tokType, lexeme, g_line);
                    return tok;
                } else {
                    var tokType: i32;
                    tokType = INVALID;
                    var nextC: string;
                    nextC = peek();
                    var isTwoChar: bool;
                    isTwoChar = false;

                    if (c == "=" && nextC == "=") { tokType = OP_EQ; isTwoChar = true; }
                    else if (c == "!" && nextC == "=") { tokType = OP_NEQ; isTwoChar = true; }
                    else if (c == "<" && nextC == "=") { tokType = OP_LTE; isTwoChar = true; }
                    else if (c == ">" && nextC == "=") { tokType = OP_GTE; isTwoChar = true; }
                    else if (c == "&" && nextC == "&") { tokType = OP_AND; isTwoChar = true; }
                    else if (c == "|" && nextC == "|") { tokType = OP_OR; isTwoChar = true; }
                    else if (c == "-" && nextC == ">") { tokType = ARROW; isTwoChar = true; }
                    else if (c == "." && nextC == ".") { tokType = RANGE; isTwoChar = true; }
                    else if (c == "(") { tokType = LPAREN; }
                    else if (c == ")") { tokType = RPAREN; }
                    else if (c == "{") { tokType = LBRACE; }
                    else if (c == "}") { tokType = RBRACE; }
                    else if (c == "[") { tokType = LBRACKET; }
                    else if (c == "]") { tokType = RBRACKET; }
                    else if (c == ",") { tokType = COMMA; }
                    else if (c == ";") { tokType = SEMICOLON; }
                    else if (c == ":") { tokType = COLON; }
                    else if (c == ".") { tokType = DOT; }
                    else if (c == "=") { tokType = EQ; }
                    else if (c == "+") { tokType = OP_PLUS; }
                    else if (c == "-") { tokType = OP_MINUS; }
                    else if (c == "*") { tokType = OP_STAR; }
                    else if (c == "/") { tokType = OP_SLASH; }
                    else if (c == "%") { tokType = OP_PERCENT; }
                    else if (c == "!") { tokType = OP_NOT; }

                    var tok: Token;
                    tok.type = tokType;
                    tok.lexeme = c;
                    tok.line = g_line;

                    addToken(tokType, c, g_line);
                    g_pos = g_pos + 1;
                    if (isTwoChar) {
                        g_pos = g_pos + 1;
                    }
                    return tok;
                }
            }
        }
    }
    
    var eof: Token;
    eof.type = EOF;
    eof.lexeme = "";
    eof.line = g_line;
    
    addToken(EOF, "", g_line);
    return eof;
}

proc tokenCount(): i32 {
    return g_tokenCount;
}

proc getTokenType(n: i32): i32 {
    if (n >= 0 && n < g_tokenCount) {
        return g_tokenTypeValues[n];
    }
    return EOF;
}

proc getTokenLexeme(n: i32): string {
    if (n >= 0 && n < g_tokenCount) {
        return g_tokenLexemes[n];
    }
    return "";
}
